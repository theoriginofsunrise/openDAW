@@ -0,0 +1,56 @@
+import {describe, expect, it} from "vitest"
+import {UUID} from "@opendaw/lib-std"
+import {ProjectOrder} from "./ProjectOrder"
+
+const project = (n: number, modified: string) => ({
+    uuid: UUID.parse(`00000000-0000-0000-0000-00000000000${n}`), meta: {modified}
+})
+const id = (n: number) => UUID.toString(UUID.parse(`00000000-0000-0000-0000-00000000000${n}`))
+const names = (list: ReadonlyArray<{ uuid: UUID.Bytes }>) => list.map(({uuid}) => UUID.toString(uuid).slice(-1))
+
+describe("ProjectOrder.sort", () => {
+    const a = project(1, "2026-11-01T10:00:00Z")
+    const b = project(2, "2026-11-03T10:00:00Z")
+    const c = project(3, "2026-11-02T10:00:00Z")
+
+    it("puts the newest first when no order was saved", () => {
+        expect(names(ProjectOrder.sort([a, b, c], []))).toEqual(["2", "3", "1"])
+    })
+
+    it("follows the saved order", () => {
+        expect(names(ProjectOrder.sort([a, b, c], [id(1), id(3), id(2)]))).toEqual(["1", "3", "2"])
+    })
+
+    it("puts a project that is not in the saved order on top", () => {
+        expect(names(ProjectOrder.sort([a, b, c], [id(1), id(3)]))).toEqual(["2", "1", "3"])
+    })
+
+    it("ignores saved ids of projects that no longer exist", () => {
+        expect(names(ProjectOrder.sort([a, c], [id(2), id(3), id(1)]))).toEqual(["3", "1"])
+    })
+})
+
+describe("ProjectOrder.arrange", () => {
+    const list = ["a", "b", "c", "d"]
+
+    it("moves a project up and down by one place", () => {
+        expect(ProjectOrder.arrange(list, "c", "up")).toEqual(["a", "c", "b", "d"])
+        expect(ProjectOrder.arrange(list, "b", "down")).toEqual(["a", "c", "b", "d"])
+    })
+
+    it("moves a project to the top", () => {
+        expect(ProjectOrder.arrange(list, "d", "top")).toEqual(["d", "a", "b", "c"])
+    })
+
+    it("stays put at the ends and for unknown ids", () => {
+        expect(ProjectOrder.arrange(list, "a", "up")).toEqual(list)
+        expect(ProjectOrder.arrange(list, "d", "down")).toEqual(list)
+        expect(ProjectOrder.arrange(list, "a", "top")).toEqual(list)
+        expect(ProjectOrder.arrange(list, "z", "up")).toEqual(list)
+    })
+
+    it("does not change the list it was given", () => {
+        ProjectOrder.arrange(list, "d", "top")
+        expect(list).toEqual(["a", "b", "c", "d"])
+    })
+})
diff --git a/packages/app/studio/src/project/ProjectOrder.ts b/packages/app/studio/src/project/ProjectOrder.ts
new file mode 100644
index 0000000..339746c
--- /dev/null
+++ b/packages/app/studio/src/project/ProjectOrder.ts
@@ -0,0 +1,51 @@
+import {StringComparator, UUID} from "@opendaw/lib-std"
+
+// Phone fork: the order of the projects in the dashboard list. Without a saved order the newest project comes
+// first. Once the order was changed by hand it is kept on this device (it is not synced to other devices).
+export namespace ProjectOrder {
+    const Key = "opendaw-project-order"
+
+    export type Action = "up" | "down" | "top"
+
+    export const load = (): ReadonlyArray<string> => {
+        try {
+            const parsed: unknown = JSON.parse(localStorage.getItem(Key) ?? "[]")
+            return Array.isArray(parsed) ? parsed.filter((entry): entry is string => typeof entry === "string") : []
+        } catch (_error) {
+            return []
+        }
+    }
+
+    export const save = (order: ReadonlyArray<string>): void => {
+        try {localStorage.setItem(Key, JSON.stringify(order))} catch (_error) {/* storage not available */}
+    }
+
+    type Entry = { readonly uuid: UUID.Bytes, readonly meta: { readonly modified: string } }
+
+    /**
+     * Projects that are not in the saved order (new ones) come first, newest first, then the projects in the
+     * saved order. Ids in the saved order that no longer exist are ignored.
+     */
+    export const sort = <T extends Entry>(projects: ReadonlyArray<T>, order: ReadonlyArray<string> = load()): Array<T> => {
+        const position = new Map(order.map((uuid, index) => [uuid, index] as const))
+        const fresh = projects
+            .filter(({uuid}) => !position.has(UUID.toString(uuid)))
+            .toSorted((a, b) => -StringComparator(a.meta.modified, b.meta.modified))
+        const ordered = projects
+            .filter(({uuid}) => position.has(UUID.toString(uuid)))
+            .toSorted((a, b) => (position.get(UUID.toString(a.uuid)) ?? 0) - (position.get(UUID.toString(b.uuid)) ?? 0))
+        return [...fresh, ...ordered]
+    }
+
+    // The new order after moving one project of the order that is displayed right now.
+    export const arrange = (displayed: ReadonlyArray<string>, uuid: string, action: Action): Array<string> => {
+        const order = [...displayed]
+        const index = order.indexOf(uuid)
+        if (index < 0) {return order}
+        const target = action === "top" ? 0 : action === "up" ? index - 1 : index + 1
+        if (target < 0 || target >= order.length || target === index) {return order}
+        order.splice(index, 1)
+        order.splice(target, 0, uuid)
+        return order
+    }
+}
