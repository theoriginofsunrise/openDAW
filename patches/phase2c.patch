diff --git a/packages/studio/core/src/ysync/RoomServer.test.ts b/packages/studio/core/src/ysync/RoomServer.test.ts
new file mode 100644
index 0000000..b3ee5ec
--- /dev/null
+++ b/packages/studio/core/src/ysync/RoomServer.test.ts
@@ -0,0 +1,42 @@
+import {afterEach, describe, expect, it} from "vitest"
+import {RoomServer} from "./RoomServer"
+
+describe("RoomServer", () => {
+    afterEach(() => RoomServer.reset())
+
+    it("uses the openDAW rooms when there is no server of our own", () => {
+        expect(RoomServer.ours()).toBe(false)
+        expect(RoomServer.url()).toBe("wss://live.opendaw.studio")
+        expect(RoomServer.token()).toBeNull()
+        expect(RoomServer.authorize("wss://live.opendaw.studio/signaling")).toBe("wss://live.opendaw.studio/signaling")
+    })
+
+    it("turns the web address of our server into a socket address", () => {
+        RoomServer.configure("https://echostudio-server.echostudio.workers.dev/", () => "t")
+        expect(RoomServer.ours()).toBe(true)
+        expect(RoomServer.url()).toBe("wss://echostudio-server.echostudio.workers.dev")
+        RoomServer.configure("http://localhost:8787", () => "t")
+        expect(RoomServer.url()).toBe("ws://localhost:8787")
+    })
+
+    it("adds the login to addresses of our server only", () => {
+        RoomServer.configure("https://echo.example", () => "a b/c")
+        expect(RoomServer.authorize("wss://echo.example/signaling")).toBe("wss://echo.example/signaling?token=a%20b%2Fc")
+        expect(RoomServer.authorize("wss://echo.example/signaling?x=1")).toBe("wss://echo.example/signaling?x=1&token=a%20b%2Fc")
+        expect(RoomServer.authorize("wss://other.example/signaling")).toBe("wss://other.example/signaling")
+    })
+
+    it("leaves the address alone while nobody is signed in", () => {
+        RoomServer.configure("https://echo.example", () => null)
+        expect(RoomServer.authorize("wss://echo.example/signaling")).toBe("wss://echo.example/signaling")
+        expect(RoomServer.token()).toBeNull()
+    })
+
+    it("asks for the login anew every time, so a fresh sign-in is picked up", () => {
+        let login: string | null = null
+        RoomServer.configure("https://echo.example", () => login)
+        expect(RoomServer.token()).toBeNull()
+        login = "fresh"
+        expect(RoomServer.token()).toBe("fresh")
+    })
+})
diff --git a/packages/studio/core/src/ysync/RoomServer.ts b/packages/studio/core/src/ysync/RoomServer.ts
new file mode 100644
index 0000000..5540bcc
--- /dev/null
+++ b/packages/studio/core/src/ysync/RoomServer.ts
@@ -0,0 +1,29 @@
+// Where the live rooms are. Without our own server in the build, the rooms of the openDAW project (which accepts
+// only its own website, so they do not work from here). With it, rooms and the peer-to-peer go-between live on our
+// Cloudflare server, and a connection carries the login (?token=...) because a browser cannot send a header with it.
+export namespace RoomServer {
+    const Upstream = "wss://live.opendaw.studio"
+
+    let config: { url: string, token: () => string | null } | null = null
+
+    export const configure = (serverUrl: string, token: () => string | null): void => {
+        config = {url: serverUrl.trim().replace(/^http/i, "ws").replace(/\/+$/, ""), token}
+    }
+
+    /** Our own server is used. */
+    export const ours = (): boolean => config !== null
+
+    export const url = (): string => config?.url ?? Upstream
+
+    export const token = (): string | null => config?.token() ?? null
+
+    /** The address with the login added, when it is an address of our own server. Others stay as they are. */
+    export const authorize = (address: string): string => {
+        if (config === null || !address.startsWith(config.url)) {return address}
+        const login = config.token()
+        if (login === null) {return address}
+        return `${address}${address.includes("?") ? "&" : "?"}token=${encodeURIComponent(login)}`
+    }
+
+    export const reset = (): void => {config = null}
+}
