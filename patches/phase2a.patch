@@ -0,0 +1,219 @@
+import {afterEach, beforeEach, describe, expect, it, vi} from "vitest"
+import {Errors} from "@opendaw/lib-std"
+import {EchoAutoSync, EchoSyncDeps, EchoSyncReason} from "./EchoAutoSync"
+import {EchoSessionExpired} from "./EchoCloudHandler"
+import {CloudHandler} from "./CloudHandler"
+
+const handler = {} as CloudHandler
+
+const setup = (overrides: Partial<EchoSyncDeps> = {}) => {
+    let now = 1_000_000
+    const runs: Array<EchoSyncReason> = []
+    const notices: Array<string> = []
+    let notes: Array<string> = []
+    const deps: EchoSyncDeps = {
+        enabled: true,
+        peek: () => handler,
+        login: () => Promise.resolve(handler),
+        run: async (_handler, reason) => {runs.push(reason)},
+        takeNotes: () => notes.splice(0, notes.length),
+        notify: message => notices.push(message),
+        now: () => now,
+        ...overrides
+    }
+    const sync = new EchoAutoSync(deps)
+    return {
+        sync, runs, notices, setNotes: (lines: Array<string>) => {notes = lines},
+        advance: async (ms: number) => {
+            now += ms
+            await vi.advanceTimersByTimeAsync(ms)
+        }
+    }
+}
+
+describe("EchoAutoSync", () => {
+    beforeEach(() => {vi.useFakeTimers()})
+    afterEach(() => {vi.useRealTimers()})
+
+    it("does nothing at all when there is no storage server in this build", async () => {
+        const {sync, runs} = setup({enabled: false})
+        expect(sync.state.getValue()).toBe("off")
+        sync.request("start")
+        await sync.syncNow()
+        await vi.advanceTimersByTimeAsync(10_000)
+        expect(runs).toEqual([])
+        expect(sync.state.getValue()).toBe("off")
+    })
+
+    it("stays quiet and opens no login window when not signed in", async () => {
+        const login = vi.fn(() => Promise.resolve(handler))
+        const {sync, runs} = setup({peek: () => null, login})
+        sync.request("start")
+        await vi.advanceTimersByTimeAsync(10)
+        expect(runs).toEqual([])
+        expect(login).not.toHaveBeenCalled()
+        expect(sync.state.getValue()).toBe("signed-out")
+    })
+
+    it("syncs right away at the start when signed in", async () => {
+        const {sync, runs} = setup()
+        sync.request("start")
+        await vi.advanceTimersByTimeAsync(10)
+        expect(runs).toEqual(["start"])
+        expect(sync.state.getValue()).toBe("idle")
+    })
+
+    it("waits a moment after a save and turns a series of saves into one sync", async () => {
+        const {sync, runs} = setup()
+        sync.request("save")
+        await vi.advanceTimersByTimeAsync(EchoAutoSync.SaveDelay - 100)
+        expect(runs).toEqual([])
+        sync.request("save")
+        sync.request("delete")
+        await vi.advanceTimersByTimeAsync(200)
+        expect(runs).toEqual(["save"])
+        await vi.advanceTimersByTimeAsync(10_000)
+        expect(runs).toEqual(["save"])
+    })
+
+    it("does not sync again at once when the app comes back to the front, but does after a while", async () => {
+        const {sync, runs, advance} = setup()
+        sync.request("start")
+        await advance(10)
+        sync.request("visible")
+        await advance(30_000)
+        expect(runs).toEqual(["start"])
+        await advance(40_000)
+        sync.request("visible")
+        await advance(10)
+        expect(runs).toEqual(["start", "visible"])
+    })
+
+    it("lets the timer wait longer than coming back to the front", async () => {
+        const {sync, runs, advance} = setup()
+        sync.request("start")
+        await advance(10)
+        await advance(100_000)
+        sync.request("timer")
+        await advance(10)
+        expect(runs).toEqual(["start"])
+        await advance(60_000)
+        sync.request("timer")
+        await advance(10)
+        expect(runs).toEqual(["start", "timer"])
+    })
+
+    it("tells the person what the sync did", async () => {
+        const {sync, notices, setNotes} = setup()
+        setNotes(["'Song' was updated from the cloud.", "'Beat' was kept."])
+        await sync.syncNow()
+        expect(notices).toEqual(["'Song' was updated from the cloud.\n'Beat' was kept."])
+    })
+
+    it("logs in when the person asks for a sync, then syncs", async () => {
+        let loggedIn = false
+        const {sync, runs} = setup({
+            peek: () => loggedIn ? handler : null,
+            login: async () => {
+                loggedIn = true
+                return handler
+            }
+        })
+        await sync.syncNow()
+        expect(loggedIn).toBe(true)
+        expect(runs).toEqual(["manual"])
+        expect(sync.state.getValue()).toBe("idle")
+    })
+
+    it("treats a closed login window as no problem", async () => {
+        const {sync, runs} = setup({peek: () => null, login: () => Promise.reject("cancelled")})
+        await expect(sync.syncNow()).resolves.toBeUndefined()
+        expect(runs).toEqual([])
+        expect(sync.state.getValue()).toBe("signed-out")
+        const closed = setup({peek: () => null, login: () => Promise.reject(null)})
+        await expect(closed.sync.syncNow()).resolves.toBeUndefined()
+    })
+
+    it("reports a refused login (an email that is not allowed) to the person who asked", async () => {
+        const {sync, runs} = setup({
+            peek: () => null,
+            login: () => Promise.reject(new Error("someone@example.com is not allowed on this server."))
+        })
+        await expect(sync.syncNow()).rejects.toThrow("not allowed")
+        expect(runs).toEqual([])
+        expect(sync.state.getValue()).toBe("signed-out")
+    })
+
+    it("goes back to signed out, silently, when the login ended", async () => {
+        const {sync, notices} = setup({run: () => Promise.reject(new EchoSessionExpired())})
+        sync.request("start")
+        await vi.advanceTimersByTimeAsync(10)
+        expect(sync.state.getValue()).toBe("signed-out")
+        expect(notices).toEqual([])
+    })
+
+    it("shows a failed background sync once, not every time", async () => {
+        const warn = vi.spyOn(console, "warn").mockImplementation(() => {})
+        const {sync, notices, advance} = setup({run: () => Promise.reject(new Error("network down"))})
+        sync.request("start")
+        await advance(10)
+        expect(sync.state.getValue()).toBe("error")
+        expect(notices).toHaveLength(1)
+        expect(notices[0]).toContain("network down")
+        sync.request("save")
+        await advance(EchoAutoSync.SaveDelay + 10)
+        expect(notices).toHaveLength(1)
+        await advance(EchoAutoSync.ErrorNoticeGap)
+        sync.request("save")
+        await advance(EchoAutoSync.SaveDelay + 10)
+        expect(notices).toHaveLength(2)
+        warn.mockRestore()
+    })
+
+    it("reports a failed sync to the person who asked for it", async () => {
+        const warn = vi.spyOn(console, "warn").mockImplementation(() => {})
+        const {sync, notices} = setup({run: () => Promise.reject(new Error("disk full"))})
+        await expect(sync.syncNow()).rejects.toThrow("disk full")
+        expect(sync.state.getValue()).toBe("error")
+        expect(notices).toEqual([])
+        warn.mockRestore()
+    })
+
+    it("treats an aborted sync as nothing to worry about", async () => {
+        const {sync, notices} = setup({run: () => Promise.reject(Errors.AbortError)})
+        await sync.syncNow()
+        expect(sync.state.getValue()).toBe("idle")
+        expect(notices).toEqual([])
+    })
+
+    it("never runs two syncs at the same time", async () => {
+        let active = 0
+        let most = 0
+        const {sync, runs} = setup({
+            run: async (_handler, reason) => {
+                active++
+                most = Math.max(most, active)
+                await new Promise(resolve => setTimeout(resolve, 100))
+                active--
+                runs.push(reason)
+            }
+        })
+        const first = sync.syncNow()
+        const second = sync.syncNow()
+        sync.request("start")
+        await vi.advanceTimersByTimeAsync(1000)
+        await Promise.all([first, second])
+        expect(most).toBe(1)
+        expect(runs.length).toBe(3)
+    })
+
+    it("shows the state while syncing", async () => {
+        const seen: Array<string> = []
+        const {sync} = setup({run: async () => {await new Promise(resolve => setTimeout(resolve, 50))}})
+        sync.state.subscribe(owner => seen.push(owner.getValue()))
+        const done = sync.syncNow()
+        await vi.advanceTimersByTimeAsync(100)
+        await done
+        expect(seen).toEqual(["syncing", "idle"])
+    })
+})
diff --git a/packages/studio/core/src/cloud/EchoAutoSync.ts b/packages/studio/core/src/cloud/EchoAutoSync.ts
new file mode 100644
index 0000000..8d6f568
--- /dev/null
+++ b/packages/studio/core/src/cloud/EchoAutoSync.ts
@@ -0,0 +1,194 @@
+import {DefaultObservableValue, Errors, ObservableValue, Progress, RuntimeSignal, Terminable} from "@opendaw/lib-std"
+import {CloudHandler} from "./CloudHandler"
+import {EchoSessionExpired} from "./EchoCloudHandler"
+import {CloudBackupSamples} from "./CloudBackupSamples"
+import {CloudBackupProjects} from "./CloudBackupProjects"
+import {CloudBackupTemplates} from "./CloudBackupTemplates"
+import {CloudBackupSoundfonts} from "./CloudBackupSoundfonts"
+import {CloudBackupPresets} from "./CloudBackupPresets"
+import {CloudBackupScripts} from "./CloudBackupScripts"
+import {CloudBackupWclaps} from "./CloudBackupWclaps"
+import {CloudSyncHooks} from "./CloudSyncHooks"
+import {CloudAuthManager} from "./CloudAuthManager"
+import {ProjectSignals} from "../project/ProjectSignals"
+import {ProjectStorage} from "../project/ProjectStorage"
+
+// off: no storage server in this build. signed-out: not logged in, nothing is synced. idle: in sync as of the last run.
+export type EchoSyncState = "off" | "signed-out" | "idle" | "syncing" | "error"
+
+export type EchoSyncReason = "start" | "save" | "delete" | "visible" | "timer" | "manual"
+
+export type EchoSyncDeps = {
+    readonly enabled: boolean
+    // a handler whose login is valid, or null. Never opens a login window.
+    peek(): CloudHandler | null
+    // opens the login window (only when the person asked for it)
+    login(): Promise<CloudHandler>
+    // one sync: what to upload, what to receive
+    run(handler: CloudHandler, reason: EchoSyncReason): Promise<void>
+    takeNotes(): ReadonlyArray<string>
+    notify(message: string): void
+    now(): number
+}
+
+/**
+ * Keeps the projects of this device and the storage server in step without the person doing anything: right when the
+ * app starts (and the login is still good), a moment after every save or delete, when the app comes back to the
+ * front, and every few minutes. A sync is the same careful one as the manual Sync (it never overwrites a project that
+ * changed in two places without asking), and only one runs at a time.
+ */
+export class EchoAutoSync {
+    static readonly SaveDelay = 2000
+    static readonly MinGapVisible = 60 * 1000
+    static readonly MinGapTimer = 150 * 1000
+    static readonly ErrorNoticeGap = 5 * 60 * 1000
+
+    readonly #deps: EchoSyncDeps
+    readonly #state: DefaultObservableValue<EchoSyncState>
+    #chain: Promise<unknown> = Promise.resolve()
+    #timer: ReturnType<typeof setTimeout> | undefined
+    #lastSuccess: number = Number.NEGATIVE_INFINITY
+    #lastErrorNotice: number = Number.NEGATIVE_INFINITY
+    #pending: boolean = false
+
+    constructor(deps: EchoSyncDeps) {
+        this.#deps = deps
+        this.#state = new DefaultObservableValue<EchoSyncState>(deps.enabled ? "signed-out" : "off")
+    }
+
+    get state(): ObservableValue<EchoSyncState> {return this.#state}
+
+    get enabled(): boolean {return this.#deps.enabled}
+
+    /**
+     * Asks for a sync without the person waiting for it. A save or a delete waits a moment, so that a series of them
+     * becomes one sync. Coming back to the front and the timer only sync when the last sync is not recent.
+     */
+    request(reason: EchoSyncReason): void {
+        if (!this.#deps.enabled) {return}
+        const gap = reason === "visible" ? EchoAutoSync.MinGapVisible : reason === "timer" ? EchoAutoSync.MinGapTimer : 0
+        if (gap > 0 && this.#deps.now() - this.#lastSuccess < gap) {return}
+        if (this.#pending) {return}
+        const delay = reason === "save" || reason === "delete" ? EchoAutoSync.SaveDelay : 0
+        this.#pending = true
+        clearTimeout(this.#timer)
+        this.#timer = setTimeout(() => {
+            this.#pending = false
+            void this.#enqueue(false, reason)
+        }, delay)
+    }
+
+    /**
+     * The person asked for a sync: logs in if needed, and reports problems to the caller instead of staying silent.
+     */
+    syncNow(): Promise<void> {
+        if (!this.#deps.enabled) {return Promise.resolve()}
+        return this.#enqueue(true, "manual")
+    }
+
+    /** Wires the triggers: saves and deletes, coming back to the front, a timer, and the first sync. */
+    start(): Terminable {
+        if (!this.#deps.enabled) {return Terminable.Empty}
+        const subscription = RuntimeSignal.subscribe(signal => {
+            if (signal === ProjectSignals.ProjectSaved) {this.request("save")}
+            if (signal === ProjectSignals.ProjectDeleted) {this.request("delete")}
+        })
+        const onVisible = (): void => {if (document.visibilityState === "visible") {this.request("visible")}}
+        const interval = setInterval(() => {if (document.visibilityState === "visible") {this.request("timer")}}, 60 * 1000)
+        document.addEventListener("visibilitychange", onVisible)
+        this.request("start")
+        return {
+            terminate: () => {
+                subscription.terminate()
+                clearInterval(interval)
+                clearTimeout(this.#timer)
+                document.removeEventListener("visibilitychange", onVisible)
+            }
+        }
+    }
+
+    #enqueue(interactive: boolean, reason: EchoSyncReason): Promise<void> {
+        const task = (): Promise<void> => this.#execute(interactive, reason)
+        const next = this.#chain.then(task, task) as Promise<void>
+        this.#chain = next.catch(() => {})
+        return next
+    }
+
+    async #execute(interactive: boolean, reason: EchoSyncReason): Promise<void> {
+        let handler = this.#deps.peek()
+        if (handler === null) {
+            if (!interactive) {
+                this.#state.setValue("signed-out")
+                return
+            }
+            try {
+                handler = await this.#deps.login()
+            } catch (error) {
+                this.#state.setValue("signed-out")
+                // closing the login window is not a failure
+                if (error === null || error === "cancelled" || Errors.isAbort(error)) {return}
+                throw error
+            }
+        }
+        this.#state.setValue("syncing")
+        try {
+            await this.#deps.run(handler, reason)
+            this.#lastSuccess = this.#deps.now()
+            this.#state.setValue("idle")
+            const notes = this.#deps.takeNotes()
+            if (notes.length > 0) {this.#deps.notify(notes.join("\n"))}
+        } catch (error) {
+            this.#deps.takeNotes()
+            if (error instanceof EchoSessionExpired) {
+                this.#state.setValue("signed-out")
+                return
+            }
+            if (Errors.isAbort(error)) {
+                this.#state.setValue("idle")
+                return
+            }
+            console.warn("[EchoAutoSync]", error)
+            this.#state.setValue("error")
+            const now = this.#deps.now()
+            if (interactive) {throw error}
+            if (now - this.#lastErrorNotice >= EchoAutoSync.ErrorNoticeGap) {
+                this.#lastErrorNotice = now
+                this.#deps.notify(`Could not sync with the storage server: ${error instanceof Error ? error.message : String(error)}`)
+            }
+        }
+    }
+
+    // Everything the app wires in at its start.
+    static create(auth: CloudAuthManager, notify: (message: string) => void): EchoAutoSync {
+        const quiet = (): void => {}
+        const signature = async (): Promise<string> => (await ProjectStorage.listProjects())
+            .map(({uuid, meta}) => `${uuid}:${meta.modified}`).sort().join("|")
+        const autoSync: EchoAutoSync = new EchoAutoSync({
+            enabled: auth.echoEnabled,
+            peek: () => auth.peekHandler("Echo"),
+            login: () => auth.getHandler("Echo"),
+            run: async (handler, reason) => {
+                const before = await signature()
+                // upload what the cloud is missing, without downloading all of it: audio comes when a project needs it
+                await CloudBackupSamples.start(handler, Progress.Empty, quiet, {download: false})
+                await CloudBackupProjects.start(handler, "Echo", Progress.Empty, quiet, {confirmDeletes: false})
+                if (reason === "manual") {
+                    // the Sync button also brings the rest along: templates, soundfonts, presets, scripts, plug-ins
+                    await CloudBackupTemplates.start(handler, Progress.Empty, quiet)
+                    await CloudBackupSoundfonts.start(handler, Progress.Empty, quiet)
+                    await CloudBackupPresets.start(handler, Progress.Empty, quiet)
+                    await CloudBackupScripts.start(handler, Progress.Empty, quiet)
+                    await CloudBackupWclaps.start(handler, Progress.Empty, quiet)
+                }
+                // what came down, or went away, changes what the dashboard shows
+                if (before !== await signature()) {RuntimeSignal.dispatch(ProjectSignals.StorageUpdated)}
+            },
+            takeNotes: () => CloudSyncHooks.takeNotes(),
+            notify,
+            now: () => Date.now()
+        })
+        // a login (also one made from the Sync button) starts a sync
+        auth.subscribeHandler(() => autoSync.request("start"))
+        return autoSync
+    }
+}
diff --git a/packages/studio/core/src/cloud/EchoCloudHandler.test.ts b/packages/studio/core/src/cloud/EchoCloudHandler.test.ts
new file mode 100644
index 0000000..b11b68e
--- /dev/null
+++ b/packages/studio/core/src/cloud/EchoCloudHandler.test.ts
@@ -0,0 +1,178 @@
+import {describe, expect, it} from "vitest"
+import {Errors} from "@opendaw/lib-std"
+import {EchoCloudHandler, EchoPreconditionFailed, EchoSessionExpired, isSharedFile} from "./EchoCloudHandler"
+
+type Call = { url: string, init: RequestInit }
+
+const create = (respond: (call: Call) => Response, limits?: { singleLimit?: number, partSize?: number }) => {
+    const calls: Array<Call> = []
+    let ended = 0
+    const handler = new EchoCloudHandler("https://server.example/", "token-1", async (input, init = {}) => {
+        const call = {url: String(input), init}
+        calls.push(call)
+        return respond(call)
+    }, () => {ended++}, limits)
+    return {handler, calls, ended: () => ended}
+}
+const json = (body: unknown, status = 200, headers: Record<string, string> = {}) =>
+    new Response(JSON.stringify(body), {status, headers})
+const header = (call: Call, name: string) => (call.init.headers as Record<string, string>)[name]
+
+describe("EchoCloudHandler", () => {
+    it("knows which files every device shares", () => {
+        expect(isSharedFile("projects/index.json")).toBe(true)
+        expect(isSharedFile("samples/index.json")).toBe(true)
+        expect(isSharedFile("projects/tombstones.json")).toBe(true)
+        expect(isSharedFile("samples/structure.json")).toBe(true)
+        expect(isSharedFile("projects/abc/meta.json")).toBe(false)
+        expect(isSharedFile("projects/abc/project.od")).toBe(false)
+        expect(isSharedFile("presence/abc/session.json")).toBe(false)
+    })
+
+    it("sends the login with every request and encodes every part of a path", async () => {
+        const {handler, calls} = create(() => json({etag: "e1"}))
+        await handler.upload("projects/my song/a+b#1.od", new ArrayBuffer(3))
+        expect(calls[0].url).toBe("https://server.example/files/projects/my%20song/a%2Bb%231.od")
+        expect(header(calls[0], "Authorization")).toBe("Bearer token-1")
+        expect(calls[0].init.method).toBe("PUT")
+    })
+
+    it("checks the answer of the server and turns 404 into 'file not found'", async () => {
+        const {handler} = create(call => call.url.endsWith("/missing.od") ? json({error: "not_found"}, 404) : new Response(new Uint8Array([7, 8]), {status: 200}))
+        await expect(handler.download("a/missing.od")).rejects.toBeInstanceOf(Errors.FileNotFound)
+        expect(Array.from(new Uint8Array(await handler.download("a/there.od")))).toEqual([7, 8])
+    })
+
+    it("tells whether a file exists", async () => {
+        const {handler, calls} = create(call => new Response(null, {status: call.url.endsWith("/yes") ? 200 : 404}))
+        expect(await handler.exists("a/yes")).toBe(true)
+        expect(await handler.exists("a/no")).toBe(false)
+        expect(calls[0].init.method).toBe("HEAD")
+    })
+
+    it("lists a folder, and the root", async () => {
+        const {handler, calls} = create(() => json({names: ["a", "b"]}))
+        expect(await handler.list("projects/p 1")).toEqual(["a", "b"])
+        expect(calls[0].url).toBe("https://server.example/list?path=projects%2Fp%201")
+        await handler.list()
+        expect(calls[1].url).toBe("https://server.example/list?path=")
+    })
+
+    it("deletes", async () => {
+        const {handler, calls} = create(() => json({ok: true}))
+        await handler.delete("projects/p1")
+        expect(calls[0].init.method).toBe("DELETE")
+        expect(calls[0].url).toBe("https://server.example/files/projects/p1")
+    })
+
+    it("fails loudly on a server error", async () => {
+        const {handler} = create(() => new Response("boom", {status: 500}))
+        await expect(handler.upload("a.od", new ArrayBuffer(1))).rejects.toThrow("500")
+        await expect(handler.download("a.od")).rejects.toThrow("500")
+        await expect(handler.list("a")).rejects.toThrow("500")
+        await expect(handler.delete("a")).rejects.toThrow("500")
+        await expect(handler.alive()).rejects.toThrow("500")
+    })
+
+    it("is alive when the server knows the login", async () => {
+        const {handler, calls} = create(() => json({email: "me@example.com"}))
+        await expect(handler.alive()).resolves.toBeUndefined()
+        expect(calls[0].url).toBe("https://server.example/auth/me")
+    })
+
+    it("ends the login and says so when the server does not accept it", async () => {
+        const {handler, ended} = create(() => json({error: "unauthorized"}, 401))
+        await expect(handler.download("a.od")).rejects.toBeInstanceOf(EchoSessionExpired)
+        await expect(handler.alive()).rejects.toBeInstanceOf(EchoSessionExpired)
+        expect(ended()).toBe(2)
+    })
+
+    describe("shared files", () => {
+        it("only overwrites the version it last read", async () => {
+            const {handler, calls} = create(call => call.init.method === "PUT"
+                ? json({etag: "e2"}) : new Response("{}", {status: 200, headers: {ETag: "\"e1\""}}))
+            await handler.upload("projects/index.json", new ArrayBuffer(2))
+            expect(header(calls[0], "X-Echo-If-Match")).toBeUndefined()
+            await handler.download("projects/index.json")
+            await handler.upload("projects/index.json", new ArrayBuffer(2))
+            expect(header(calls[2], "X-Echo-If-Match")).toBe("e1")
+            await handler.upload("projects/index.json", new ArrayBuffer(2))
+            expect(header(calls[3], "X-Echo-If-Match")).toBe("e2")
+        })
+
+        it("says so when somebody else changed the file in between", async () => {
+            const {handler} = create(call => call.init.method === "PUT"
+                ? json({error: "precondition_failed"}, 412) : new Response("{}", {status: 200, headers: {ETag: "\"e1\""}}))
+            await handler.download("projects/index.json")
+            const failure = await handler.upload("projects/index.json", new ArrayBuffer(2)).catch(error => error)
+            expect(failure).toBeInstanceOf(EchoPreconditionFailed)
+            expect(failure.message).toContain("projects/index.json")
+        })
+
+        it("does not check ordinary files (a project, a sample)", async () => {
+            const {handler, calls} = create(call => call.init.method === "PUT"
+                ? json({etag: "e2"}) : new Response("x", {status: 200, headers: {ETag: "\"e1\""}}))
+            await handler.download("projects/p1/project.od")
+            await handler.upload("projects/p1/project.od", new ArrayBuffer(2))
+            expect(header(calls[1], "X-Echo-If-Match")).toBeUndefined()
+        })
+
+        it("forgets a version when the person decided to replace the cloud copy", async () => {
+            const {handler, calls} = create(call => call.init.method === "PUT"
+                ? json({etag: "e2"}) : new Response("{}", {status: 200, headers: {ETag: "\"e1\""}}))
+            await handler.download("projects/index.json")
+            handler.forgetVersion("projects/index.json")
+            await handler.upload("projects/index.json", new ArrayBuffer(2))
+            expect(header(calls[1], "X-Echo-If-Match")).toBeUndefined()
+        })
+
+        it("forgets a version for a file that was deleted", async () => {
+            const {handler, calls} = create(call => call.init.method === "GET"
+                ? new Response("{}", {status: 200, headers: {ETag: "\"e1\""}}) : json({etag: "e3", ok: true}))
+            await handler.download("projects/index.json")
+            await handler.delete("projects/index.json")
+            await handler.upload("projects/index.json", new ArrayBuffer(2))
+            expect(header(calls[2], "X-Echo-If-Match")).toBeUndefined()
+        })
+    })
+
+    describe("big files", () => {
+        const respond = (call: Call): Response => {
+            if (call.url.includes("/mpu/create")) {return json({uploadId: "u1"})}
+            if (call.url.includes("/mpu/part")) {return json({partNumber: Number(new URL(call.url).searchParams.get("part")), etag: "p"})}
+            if (call.url.includes("/mpu/complete")) {return json({etag: "done"})}
+            return json({ok: true})
+        }
+
+        it("goes up in parts of equal size, the last one smaller", async () => {
+            const {handler, calls} = create(respond, {singleLimit: 100, partSize: 40})
+            const progress: Array<number> = []
+            await handler.upload("samples/big.wav", new ArrayBuffer(110), value => progress.push(value))
+            const urls = calls.map(call => new URL(call.url).pathname)
+            expect(urls).toEqual(["/mpu/create", "/mpu/part", "/mpu/part", "/mpu/part", "/mpu/complete"])
+            expect(calls.slice(1, 4).map(call => (call.init.body as ArrayBuffer).byteLength)).toEqual([40, 40, 30])
+            expect(calls.slice(1, 4).map(call => new URL(call.url).searchParams.get("part"))).toEqual(["1", "2", "3"])
+            expect(JSON.parse(calls[4].init.body as string).parts.map((part: { partNumber: number }) => part.partNumber)).toEqual([1, 2, 3])
+            expect(progress).toEqual([1 / 3, 2 / 3, 1])
+        })
+
+        it("sends a file at the limit in one piece", async () => {
+            const {handler, calls} = create(respond, {singleLimit: 100, partSize: 40})
+            await handler.upload("samples/edge.wav", new ArrayBuffer(100))
+            expect(calls).toHaveLength(1)
+            expect(calls[0].init.method).toBe("PUT")
+        })
+
+        it("drops the started upload when a part fails, and says why", async () => {
+            const {handler, calls} = create(call => call.url.includes("/mpu/part") && call.url.includes("part=2")
+                ? new Response("no space", {status: 500}) : respond(call))
+            const failing = create(call => call.url.includes("part=2") ? new Response("no space", {status: 500}) : respond(call),
+                {singleLimit: 10, partSize: 5})
+            await expect(failing.handler.upload("samples/big.wav", new ArrayBuffer(20))).rejects.toThrow("part 2")
+            const last = failing.calls[failing.calls.length - 1]
+            expect(new URL(last.url).pathname).toBe("/mpu/abort")
+            expect(handler).toBeDefined()
+            expect(calls).toHaveLength(0)
+        })
+    })
+})
diff --git a/packages/studio/core/src/cloud/EchoCloudHandler.ts b/packages/studio/core/src/cloud/EchoCloudHandler.ts
new file mode 100644
index 0000000..679e5e4
--- /dev/null
+++ b/packages/studio/core/src/cloud/EchoCloudHandler.ts
@@ -0,0 +1,142 @@
+import {Errors, panic, Progress} from "@opendaw/lib-std"
+import {CloudHandler} from "./CloudHandler"
+
+export class EchoSessionExpired extends Error {
+    constructor() {super("Your login with the storage server ended. Sign in again.")}
+}
+
+export class EchoPreconditionFailed extends Error {
+    constructor(readonly path: string) {super(`'${path}' was changed by someone else in the meantime.`)}
+}
+
+// The files that every device reads, changes and writes back (catalogs, deletion records). A write to one of them is
+// only accepted when it starts from the version the device last read, so that two devices cannot overwrite each other.
+const SharedFiles: ReadonlySet<string> = new Set(["index.json", "tombstones.json", "structure.json"])
+
+export const isSharedFile = (path: string): boolean => SharedFiles.has(path.slice(path.lastIndexOf("/") + 1))
+
+/**
+ * The cloud storage of the Echo server (Cloudflare Workers + R2). Same contract as the Google Drive and Dropbox
+ * handlers, so everything the sync does works unchanged.
+ */
+export class EchoCloudHandler implements CloudHandler {
+    // up to this size a file goes up in one request, bigger ones in parts (Cloudflare accepts 100 MB per request)
+    static readonly SingleLimit = 64 * 1024 * 1024
+    // every part but the last must have exactly this size (the storage needs at least 5 MB per part)
+    static readonly PartSize = 32 * 1024 * 1024
+
+    readonly #serverUrl: string
+    readonly #token: string
+    readonly #fetch: typeof fetch
+    readonly #onUnauthorized: () => void
+    readonly #singleLimit: number
+    readonly #partSize: number
+    // the version of every shared file as this device last saw it
+    readonly #versions = new Map<string, string>()
+
+    constructor(serverUrl: string, token: string, fetcher: typeof fetch = (input, init) => fetch(input, init),
+                onUnauthorized: () => void = () => {},
+                limits: { singleLimit?: number, partSize?: number } = {}) {
+        this.#serverUrl = serverUrl.replace(/\/+$/, "")
+        this.#token = token
+        this.#fetch = fetcher
+        this.#onUnauthorized = onUnauthorized
+        this.#singleLimit = limits.singleLimit ?? EchoCloudHandler.SingleLimit
+        this.#partSize = limits.partSize ?? EchoCloudHandler.PartSize
+    }
+
+    async alive(): Promise<void> {
+        const response = await this.#send("/auth/me")
+        if (!response.ok) {return panic(`Echo server did not answer properly: ${response.status}`)}
+    }
+
+    async upload(path: string, data: ArrayBuffer, progress: Progress.Handler = Progress.Empty): Promise<void> {
+        if (data.byteLength > this.#singleLimit) {return this.#uploadInParts(path, data, progress)}
+        const headers: Record<string, string> = {"Content-Type": "application/octet-stream"}
+        const known = this.#versions.get(path)
+        if (isSharedFile(path) && known !== undefined) {headers["X-Echo-If-Match"] = known}
+        const response = await this.#send(`/files/${EchoCloudHandler.#encode(path)}`, {method: "PUT", body: data, headers})
+        if (response.status === 412) {throw new EchoPreconditionFailed(path)}
+        if (!response.ok) {return panic(`Echo upload failed: ${response.status} ${await response.text()}`)}
+        const {etag} = await response.json() as { etag: string }
+        if (isSharedFile(path)) {this.#versions.set(path, etag)}
+        progress(1.0)
+    }
+
+    async download(path: string): Promise<ArrayBuffer> {
+        const response = await this.#send(`/files/${EchoCloudHandler.#encode(path)}`)
+        if (response.status === 404) {throw new Errors.FileNotFound(path)}
+        if (!response.ok) {return panic(`Echo download failed: ${response.status} ${await response.text()}`)}
+        const etag = response.headers.get("ETag")
+        if (isSharedFile(path)) {
+            if (etag === null) {this.#versions.delete(path)} else {this.#versions.set(path, etag.replace(/"/g, ""))}
+        }
+        return response.arrayBuffer()
+    }
+
+    async exists(path: string): Promise<boolean> {
+        const response = await this.#send(`/files/${EchoCloudHandler.#encode(path)}`, {method: "HEAD"})
+        if (response.status === 404) {return false}
+        if (!response.ok) {return panic(`Echo exists failed: ${response.status}`)}
+        return true
+    }
+
+    async list(path?: string): Promise<string[]> {
+        const response = await this.#send(`/list?path=${encodeURIComponent(path ?? "")}`)
+        if (!response.ok) {return panic(`Echo list failed: ${response.status} ${await response.text()}`)}
+        return (await response.json() as { names: Array<string> }).names
+    }
+
+    async delete(path: string): Promise<void> {
+        const response = await this.#send(`/files/${EchoCloudHandler.#encode(path)}`, {method: "DELETE"})
+        if (!response.ok) {return panic(`Echo delete failed: ${response.status} ${await response.text()}`)}
+        this.#versions.delete(path)
+    }
+
+    // Forget what this device knows about the version of a file, so that the next write does not check it. Only for
+    // when the person decided to replace the cloud copy.
+    forgetVersion(path: string): void {this.#versions.delete(path)}
+
+    async #uploadInParts(path: string, data: ArrayBuffer, progress: Progress.Handler): Promise<void> {
+        const query = `path=${encodeURIComponent(path)}`
+        const created = await this.#send(`/mpu/create?${query}`, {method: "POST"})
+        if (!created.ok) {return panic(`Echo upload could not start: ${created.status} ${await created.text()}`)}
+        const {uploadId} = await created.json() as { uploadId: string }
+        try {
+            const parts: Array<{ partNumber: number, etag: string }> = []
+            const count = Math.ceil(data.byteLength / this.#partSize)
+            for (let index = 0; index < count; index++) {
+                const start = index * this.#partSize
+                const chunk = data.slice(start, Math.min(data.byteLength, start + this.#partSize))
+                const response = await this.#send(`/mpu/part?${query}&uploadId=${encodeURIComponent(uploadId)}&part=${index + 1}`,
+                    {method: "PUT", body: chunk, headers: {"Content-Type": "application/octet-stream"}})
+                if (!response.ok) {return panic(`Echo upload failed in part ${index + 1}: ${response.status} ${await response.text()}`)}
+                parts.push(await response.json() as { partNumber: number, etag: string })
+                progress((index + 1) / count)
+            }
+            const done = await this.#send(`/mpu/complete?${query}&uploadId=${encodeURIComponent(uploadId)}`,
+                {method: "POST", body: JSON.stringify({parts}), headers: {"Content-Type": "application/json"}})
+            if (!done.ok) {return panic(`Echo upload could not finish: ${done.status} ${await done.text()}`)}
+            const {etag} = await done.json() as { etag: string }
+            if (isSharedFile(path)) {this.#versions.set(path, etag)}
+        } catch (error) {
+            await this.#send(`/mpu/abort?${query}&uploadId=${encodeURIComponent(uploadId)}`, {method: "POST"}).catch(() => {})
+            throw error
+        }
+    }
+
+    async #send(route: string, init: RequestInit = {}): Promise<Response> {
+        const response = await this.#fetch(`${this.#serverUrl}${route}`, {
+            ...init, headers: {...(init.headers as Record<string, string> | undefined), Authorization: `Bearer ${this.#token}`}
+        })
+        if (response.status === 401) {
+            this.#onUnauthorized()
+            throw new EchoSessionExpired()
+        }
+        return response
+    }
+
+    static #encode(path: string): string {
+        return path.split("/").filter(part => part.length > 0).map(encodeURIComponent).join("/")
+    }
+}
diff --git a/packages/studio/core/src/cloud/EchoSampleSource.ts b/packages/studio/core/src/cloud/EchoSampleSource.ts
new file mode 100644
index 0000000..ff08650
--- /dev/null
+++ b/packages/studio/core/src/cloud/EchoSampleSource.ts
@@ -0,0 +1,42 @@
+import {Errors, Progress, UUID} from "@opendaw/lib-std"
+import {AudioData, WavFile} from "@opendaw/lib-dsp"
+import {Sample, SampleMetaData} from "@opendaw/studio-adapters"
+import {CloudHandler} from "./CloudHandler"
+import {CloudBackupSamples} from "./CloudBackupSamples"
+
+/**
+ * An audio file that is in the cloud but not on this device yet, fetched at the moment a project needs it. This is
+ * what makes a project that was saved on another device available right away: its audio comes along as it is played.
+ */
+export namespace EchoSampleSource {
+    const CatalogMaxAge = 30 * 1000
+
+    let cached: { handler: CloudHandler, at: number, samples: ReadonlyArray<Sample> } | null = null
+
+    export const forgetCatalog = (): void => {cached = null}
+
+    const catalog = async (handler: CloudHandler, now: number): Promise<ReadonlyArray<Sample>> => {
+        if (cached !== null && cached.handler === handler && now - cached.at < CatalogMaxAge) {return cached.samples}
+        const samples: ReadonlyArray<Sample> = await handler.download(CloudBackupSamples.RemoteCatalogPath)
+            .then(json => JSON.parse(new TextDecoder().decode(json)))
+            .catch(reason => reason instanceof Errors.FileNotFound ? [] : Promise.reject(reason))
+        cached = {handler, at: now, samples}
+        return samples
+    }
+
+    export const fetch = async (handler: CloudHandler, uuid: UUID.Bytes, progress: Progress.Handler,
+                                now: number = Date.now()): Promise<[AudioData, SampleMetaData]> => {
+        const uuidAsString = UUID.toString(uuid)
+        let sample = (await catalog(handler, now)).find(entry => entry.uuid === uuidAsString)
+        if (sample === undefined) {
+            // the catalog may be older than the sample: look once more
+            forgetCatalog()
+            sample = (await catalog(handler, now)).find(entry => entry.uuid === uuidAsString)
+        }
+        if (sample === undefined) {throw new Errors.FileNotFound(`sample ${uuidAsString} is not in the cloud`)}
+        progress(0.2)
+        const buffer = await handler.download(CloudBackupSamples.pathFor(sample.uuid))
+        progress(0.9)
+        return [WavFile.decodeFloats(buffer), sample]
+    }
+}
