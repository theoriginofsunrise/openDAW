+import {describe, expect, it} from "vitest"
+import {copyName} from "./ProjectCopyName"
+
+describe("copyName", () => {
+    it("adds 'copy' to a name", () => {
+        expect(copyName("Song", ["Song"])).toBe("Song copy")
+    })
+
+    it("counts on when the copy exists", () => {
+        expect(copyName("Song", ["Song", "Song copy"])).toBe("Song copy 2")
+        expect(copyName("Song", ["Song", "Song copy", "Song copy 2"])).toBe("Song copy 3")
+    })
+
+    it("does not stack the word when copying a copy", () => {
+        expect(copyName("Song copy", ["Song", "Song copy"])).toBe("Song copy 2")
+        expect(copyName("Song copy 2", ["Song", "Song copy", "Song copy 2"])).toBe("Song copy 3")
+    })
+
+    it("ignores case and spaces around names", () => {
+        expect(copyName("Song", ["SONG COPY ", "Song"])).toBe("Song copy 2")
+    })
+
+    it("fills a gap", () => {
+        expect(copyName("Song", ["Song", "Song copy 2"])).toBe("Song copy")
+    })
+
+    it("works with nothing else around", () => {
+        expect(copyName("My beat", [])).toBe("My beat copy")
+    })
+
+    it("keeps names that only contain the word", () => {
+        expect(copyName("Copycat", ["Copycat"])).toBe("Copycat copy")
+    })
+})
diff --git a/packages/app/studio/src/project/ProjectCopyName.ts b/packages/app/studio/src/project/ProjectCopyName.ts
new file mode 100644
index 0000000..c2d91b9
--- /dev/null
+++ b/packages/app/studio/src/project/ProjectCopyName.ts
@@ -0,0 +1,10 @@
+// "Song" -> "Song copy" -> "Song copy 2" ... the first of these that no project has yet. Copying a copy does not
+// stack the word ("Song copy copy"), it counts on.
+export const copyName = (name: string, existing: ReadonlyArray<string>): string => {
+    const taken = new Set(existing.map(entry => entry.trim().toLowerCase()))
+    const base = name.trim().replace(/ copy( \d+)?$/i, "")
+    for (let number = 1; ; number++) {
+        const candidate = number === 1 ? `${base} copy` : `${base} copy ${number}`
+        if (!taken.has(candidate.toLowerCase())) {return candidate}
+    }
+}
diff --git a/packages/app/studio/src/project/ProjectDuplicate.ts b/packages/app/studio/src/project/ProjectDuplicate.ts
new file mode 100644
index 0000000..30c966f
--- /dev/null
+++ b/packages/app/studio/src/project/ProjectDuplicate.ts
@@ -0,0 +1,38 @@
+import {RuntimeNotifier, RuntimeSignal, UUID} from "@opendaw/lib-std"
+import {Project, ProjectMeta, ProjectProfile, ProjectSignals, ProjectStorage} from "@opendaw/studio-core"
+import type {StudioService} from "@/service/StudioService"
+import {copyName} from "@/project/ProjectCopyName"
+
+// Makes a new project from the stored version of a project, under a new identity. The copy is saved on this device
+// and, with a storage server, goes up to it like any save.
+export const duplicateProject = async (service: StudioService, uuid: UUID.Bytes): Promise<string | null> => {
+    if (service.hasProfile && UUID.equals(service.profile.uuid, uuid) && service.profile.hasUnsavedChanges()) {
+        const approved = await RuntimeNotifier.approve({
+            headline: "Unsaved changes",
+            message: "The copy is made from the saved version of the project, without the changes you have not saved yet.",
+            approveText: "Copy saved version",
+            cancelText: "Cancel"
+        })
+        if (!approved) {return null}
+    }
+    const [buffer, metaBuffer, cover, list] = await Promise.all([
+        ProjectStorage.loadProject(uuid),
+        ProjectStorage.loadMeta(uuid),
+        ProjectStorage.loadCover(uuid),
+        ProjectStorage.listProjects()
+    ])
+    const project = await Project.loadAnyVersion(service, buffer)
+    try {
+        const meta = ProjectMeta.fromJSON(JSON.parse(new TextDecoder().decode(metaBuffer)))
+        const copyMeta = ProjectMeta.copy(meta)
+        copyMeta.name = copyName(meta.name, list.map(entry => entry.meta.name))
+        // The profile reads the old name back from the project itself, saveAs then writes the new one.
+        const profile = new ProjectProfile(UUID.generate(), project, ProjectMeta.copy(meta), cover)
+        await profile.saveAs(copyMeta)
+        RuntimeSignal.dispatch(ProjectSignals.StorageUpdated)
+        RuntimeSignal.dispatch(ProjectSignals.ProjectSaved)
+        return copyMeta.name
+    } finally {
+        project.terminate()
+    }
+}
