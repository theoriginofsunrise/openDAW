+++ b/cloudflare-server/src/cors.ts
@@ -0,0 +1,32 @@
+import {Env} from "./types"
+
+export const allowedOrigin = (env: Env, origin: string | null): string | null => {
+    if (origin === null) {return null}
+    const allowed = env.ALLOWED_ORIGINS.split(",").map(entry => entry.trim()).filter(entry => entry.length > 0)
+    return allowed.includes(origin) ? origin : null
+}
+
+const corsHeaders = (request: Request, env: Env): Headers => {
+    const headers = new Headers()
+    const origin = allowedOrigin(env, request.headers.get("Origin"))
+    if (origin !== null) {
+        headers.set("Access-Control-Allow-Origin", origin)
+        headers.set("Access-Control-Allow-Methods", "GET, HEAD, PUT, POST, DELETE, OPTIONS")
+        headers.set("Access-Control-Allow-Headers", "Authorization, Content-Type, X-Echo-If-Match")
+        headers.set("Access-Control-Expose-Headers", "ETag")
+        headers.set("Access-Control-Max-Age", "86400")
+    }
+    headers.append("Vary", "Origin")
+    // the app page is cross-origin isolated: let it read what this server sends
+    headers.set("Cross-Origin-Resource-Policy", "cross-origin")
+    return headers
+}
+
+export const preflight = (request: Request, env: Env): Response =>
+    new Response(null, {status: 204, headers: corsHeaders(request, env)})
+
+export const withCors = (response: Response, request: Request, env: Env): Response => {
+    const headers = new Headers(response.headers)
+    corsHeaders(request, env).forEach((value, key) => key === "vary" ? headers.append(key, value) : headers.set(key, value))
+    return new Response(response.body, {status: response.status, statusText: response.statusText, headers})
+}
diff --git a/cloudflare-server/src/files.ts b/cloudflare-server/src/files.ts
new file mode 100644
index 0000000..e9c6e4f
--- /dev/null
+++ b/cloudflare-server/src/files.ts
@@ -0,0 +1,126 @@
+import {Env, R2UploadedPart} from "./types"
+
+// Cloudflare's free plan accepts at most 100 MB in one request: stay below it, bigger files go in parts.
+export const MaxSingleUpload = 95 * 1024 * 1024
+const MaxPathLength = 700
+const MaxSegmentLength = 200
+
+export const json = (body: unknown, status: number = 200): Response =>
+    new Response(JSON.stringify(body), {status, headers: {"Content-Type": "application/json", "Cache-Control": "no-store"}})
+
+// A path inside a person's folder, from the decoded segments of a URL. Null when it is not acceptable.
+export const cleanPath = (raw: string, allowEmpty: boolean = false): string | null => {
+    if (raw.length > MaxPathLength) {return null}
+    const segments = raw.split("/").filter((segment, index, all) =>
+        // one leading or trailing slash is fine, empty segments in the middle are not
+        segment.length > 0 || index === 0 || index === all.length - 1)
+        .filter(segment => segment.length > 0)
+    if (segments.length === 0) {return allowEmpty ? "" : null}
+    for (const segment of segments) {
+        if (segment === "." || segment === ".." || segment.length > MaxSegmentLength
+            || /[\u0000-\u001f\\]/.test(segment)) {return null}
+    }
+    if (raw.replace(/^\/|\/$/g, "").split("/").some(segment => segment.length === 0)) {return null}
+    return segments.join("/")
+}
+
+const keyFor = (userId: string, path: string): string => `u/${userId}/${path}`
+const folderPrefix = (userId: string, path: string): string => path === "" ? `u/${userId}/` : `u/${userId}/${path}/`
+
+export const getFile = async (env: Env, userId: string, path: string): Promise<Response> => {
+    const object = await env.BUCKET.get(keyFor(userId, path))
+    if (object === null) {return json({error: "not_found"}, 404)}
+    return new Response(object.body, {
+        headers: {
+            "Content-Type": "application/octet-stream",
+            "Content-Length": String(object.size),
+            "ETag": object.httpEtag,
+            "Cache-Control": "no-store"
+        }
+    })
+}
+
+// A file, or a folder (anything stored below the path), exists.
+export const headFile = async (env: Env, userId: string, path: string): Promise<Response> => {
+    const object = await env.BUCKET.head(keyFor(userId, path))
+    if (object !== null) {return new Response(null, {status: 200, headers: {"ETag": object.httpEtag}})}
+    const below = await env.BUCKET.list({prefix: folderPrefix(userId, path), limit: 1})
+    return new Response(null, {status: below.objects.length > 0 ? 200 : 404})
+}
+
+export const putFile = async (env: Env, userId: string, path: string, request: Request): Promise<Response> => {
+    const lengthHeader = request.headers.get("Content-Length")
+    const length = Number(lengthHeader)
+    if (lengthHeader === null || !Number.isFinite(length)) {return json({error: "length_required"}, 411)}
+    if (length > MaxSingleUpload) {return json({error: "too_large", maxBytes: MaxSingleUpload}, 413)}
+    if (request.body === null) {return json({error: "empty_body"}, 400)}
+    const ifMatch = request.headers.get("X-Echo-If-Match")
+    const stored = await env.BUCKET.put(keyFor(userId, path), request.body,
+        ifMatch === null ? undefined : {onlyIf: {etagMatches: ifMatch}})
+    // null: the file is not the one the client last saw, somebody else changed it
+    if (stored === null) {return json({error: "precondition_failed"}, 412)}
+    return json({etag: stored.etag})
+}
+
+// The file, and everything below it when it is a folder. Deleting what is not there is not an error.
+export const deleteFile = async (env: Env, userId: string, path: string): Promise<Response> => {
+    const key = keyFor(userId, path)
+    await env.BUCKET.delete(key)
+    let cursor: string | undefined = undefined
+    do {
+        const page: Awaited<ReturnType<Env["BUCKET"]["list"]>> =
+            await env.BUCKET.list({prefix: `${key}/`, cursor, limit: 1000})
+        if (page.objects.length > 0) {await env.BUCKET.delete(page.objects.map(object => object.key))}
+        cursor = page.truncated ? page.cursor : undefined
+    } while (cursor !== undefined)
+    return json({ok: true})
+}
+
+// Names of what is directly inside a folder: files and sub folders, like a Drive folder listing.
+export const listFiles = async (env: Env, userId: string, path: string): Promise<Response> => {
+    const prefix = folderPrefix(userId, path)
+    const names: Array<string> = []
+    let cursor: string | undefined = undefined
+    do {
+        const page: Awaited<ReturnType<Env["BUCKET"]["list"]>> =
+            await env.BUCKET.list({prefix, delimiter: "/", cursor, limit: 1000})
+        page.objects.forEach(object => names.push(object.key.slice(prefix.length)))
+        page.delimitedPrefixes.forEach(folder => names.push(folder.slice(prefix.length).replace(/\/$/, "")))
+        cursor = page.truncated ? page.cursor : undefined
+    } while (cursor !== undefined)
+    return json({names})
+}
+
+export const multipartCreate = async (env: Env, userId: string, path: string): Promise<Response> => {
+    const upload = await env.BUCKET.createMultipartUpload(keyFor(userId, path))
+    return json({uploadId: upload.uploadId})
+}
+
+export const multipartPart = async (env: Env, userId: string, path: string, uploadId: string,
+                                    partNumber: number, request: Request): Promise<Response> => {
+    if (!Number.isInteger(partNumber) || partNumber < 1 || partNumber > 10000) {return json({error: "bad_part"}, 400)}
+    const length = Number(request.headers.get("Content-Length"))
+    if (request.headers.get("Content-Length") === null || !Number.isFinite(length)) {return json({error: "length_required"}, 411)}
+    if (length > MaxSingleUpload) {return json({error: "too_large", maxBytes: MaxSingleUpload}, 413)}
+    if (request.body === null) {return json({error: "empty_body"}, 400)}
+    const upload = env.BUCKET.resumeMultipartUpload(keyFor(userId, path), uploadId)
+    const part = await upload.uploadPart(partNumber, request.body)
+    return json({partNumber: part.partNumber, etag: part.etag})
+}
+
+export const multipartComplete = async (env: Env, userId: string, path: string, uploadId: string,
+                                        request: Request): Promise<Response> => {
+    const body = await request.json().catch(() => null) as { parts?: Array<R2UploadedPart> } | null
+    if (body === null || !Array.isArray(body.parts) || body.parts.length === 0
+        || body.parts.some(part => !Number.isInteger(part.partNumber) || typeof part.etag !== "string")) {
+        return json({error: "bad_parts"}, 400)
+    }
+    const upload = env.BUCKET.resumeMultipartUpload(keyFor(userId, path), uploadId)
+    const object = await upload.complete(body.parts.map(({partNumber, etag}) => ({partNumber, etag})))
+    return json({etag: object.etag})
+}
+
+export const multipartAbort = async (env: Env, userId: string, path: string, uploadId: string): Promise<Response> => {
+    await env.BUCKET.resumeMultipartUpload(keyFor(userId, path), uploadId).abort()
+    return json({ok: true})
+}
diff --git a/cloudflare-server/src/index.ts b/cloudflare-server/src/index.ts
new file mode 100644
index 0000000..37dac48
--- /dev/null
+++ b/cloudflare-server/src/index.ts
@@ -0,0 +1,101 @@
+import {Env} from "./types"
+import {authenticate, issueSession, verifyGoogleIdToken} from "./auth"
+import {preflight, withCors} from "./cors"
+import {
+    cleanPath,
+    deleteFile,
+    getFile,
+    headFile,
+    json,
+    listFiles,
+    multipartAbort,
+    multipartComplete,
+    multipartCreate,
+    multipartPart,
+    putFile
+} from "./files"
+
+const decodePath = (pathname: string, prefix: string): string | null => {
+    try {
+        return pathname.slice(prefix.length).split("/").map(decodeURIComponent).join("/")
+    } catch (_error) {
+        return null
+    }
+}
+
+const route = async (request: Request, env: Env): Promise<Response> => {
+    const url = new URL(request.url)
+    const {pathname} = url
+    const method = request.method
+    const nowMs = Date.now()
+    if (method === "OPTIONS") {return preflight(request, env)}
+    if (pathname === "/" && method === "GET") {return json({ok: true, name: "echostudio-server"})}
+
+    if (pathname === "/auth/google" && method === "POST") {
+        const body = await request.json().catch(() => null) as { idToken?: unknown, nonce?: unknown } | null
+        if (body === null || typeof body.idToken !== "string" || typeof body.nonce !== "string") {
+            return json({error: "bad_request"}, 400)
+        }
+        if (env.SESSION_SECRET === undefined || env.SESSION_SECRET === "") {
+            return json({error: "server_not_configured", message: "The server has no session secret yet."}, 500)
+        }
+        const result = await verifyGoogleIdToken(env, body.idToken, body.nonce, nowMs)
+        if (!result.ok) {return json({error: result.error, message: result.message}, result.status)}
+        const session = await issueSession(env, result.email, Math.floor(nowMs / 1000))
+        return json({token: session.token, email: result.email, expiresAt: session.expiresAt})
+    }
+
+    const identity = await authenticate(env, request, Math.floor(nowMs / 1000))
+    if (identity === null) {return json({error: "unauthorized"}, 401)}
+    const {userId} = identity
+
+    if (pathname === "/auth/me" && method === "GET") {return json({email: identity.email, expiresAt: identity.expiresAt})}
+
+    if (pathname.startsWith("/files/")) {
+        const decoded = decodePath(pathname, "/files/")
+        const path = decoded === null ? null : cleanPath(decoded)
+        if (path === null) {return json({error: "bad_path"}, 400)}
+        switch (method) {
+            case "GET":
+                return getFile(env, userId, path)
+            case "HEAD":
+                return headFile(env, userId, path)
+            case "PUT":
+                return putFile(env, userId, path, request)
+            case "DELETE":
+                return deleteFile(env, userId, path)
+        }
+        return json({error: "method_not_allowed"}, 405)
+    }
+
+    if (pathname === "/list" && method === "GET") {
+        const path = cleanPath(url.searchParams.get("path") ?? "", true)
+        if (path === null) {return json({error: "bad_path"}, 400)}
+        return listFiles(env, userId, path)
+    }
+
+    if (pathname.startsWith("/mpu/")) {
+        const path = cleanPath(url.searchParams.get("path") ?? "")
+        if (path === null) {return json({error: "bad_path"}, 400)}
+        const uploadId = url.searchParams.get("uploadId") ?? ""
+        if (pathname === "/mpu/create" && method === "POST") {return multipartCreate(env, userId, path)}
+        if (uploadId === "") {return json({error: "bad_request"}, 400)}
+        if (pathname === "/mpu/part" && method === "PUT") {
+            return multipartPart(env, userId, path, uploadId, Number(url.searchParams.get("part")), request)
+        }
+        if (pathname === "/mpu/complete" && method === "POST") {return multipartComplete(env, userId, path, uploadId, request)}
+        if (pathname === "/mpu/abort" && method === "POST") {return multipartAbort(env, userId, path, uploadId)}
+    }
+    return json({error: "not_found"}, 404)
+}
+
+export default {
+    async fetch(request: Request, env: Env): Promise<Response> {
+        try {
+            return withCors(await route(request, env), request, env)
+        } catch (error) {
+            console.error(error)
+            return withCors(json({error: "server_error"}, 500), request, env)
+        }
+    }
+}
diff --git a/cloudflare-server/src/jwt.ts b/cloudflare-server/src/jwt.ts
new file mode 100644
index 0000000..65ccf51
--- /dev/null
+++ b/cloudflare-server/src/jwt.ts
@@ -0,0 +1,82 @@
+const encoder = new TextEncoder()
+
+export const b64urlEncode = (bytes: Uint8Array): string => {
+    let binary = ""
+    for (let i = 0; i < bytes.length; i++) {binary += String.fromCharCode(bytes[i])}
+    return btoa(binary).replace(/\+/g, "-").replace(/\//g, "_").replace(/=+$/, "")
+}
+
+export const b64urlDecode = (text: string): Uint8Array<ArrayBuffer> => {
+    const padded = text.replace(/-/g, "+").replace(/_/g, "/") + "=".repeat((4 - text.length % 4) % 4)
+    const binary = atob(padded)
+    const bytes = new Uint8Array(new ArrayBuffer(binary.length))
+    for (let i = 0; i < binary.length; i++) {bytes[i] = binary.charCodeAt(i)}
+    return bytes
+}
+
+const jsonPart = (value: unknown): string => b64urlEncode(encoder.encode(JSON.stringify(value)))
+
+const parseJsonPart = (part: string): Record<string, unknown> | null => {
+    try {
+        const parsed: unknown = JSON.parse(new TextDecoder().decode(b64urlDecode(part)))
+        return typeof parsed === "object" && parsed !== null && !Array.isArray(parsed)
+            ? parsed as Record<string, unknown> : null
+    } catch (_error) {
+        return null
+    }
+}
+
+const hmacKey = (secret: string, usages: Array<KeyUsage>): Promise<CryptoKey> =>
+    crypto.subtle.importKey("raw", encoder.encode(secret), {name: "HMAC", hash: "SHA-256"}, false, usages)
+
+export type SessionClaims = { sub: string, iat: number, exp: number }
+
+// Our own session token (HS256): proves a person signed in with an allowed Google account.
+export const signSession = async (secret: string, claims: SessionClaims): Promise<string> => {
+    const data = `${jsonPart({alg: "HS256", typ: "JWT"})}.${jsonPart(claims)}`
+    const signature = await crypto.subtle.sign("HMAC", await hmacKey(secret, ["sign"]), encoder.encode(data))
+    return `${data}.${b64urlEncode(new Uint8Array(signature))}`
+}
+
+export const verifySession = async (secret: string, token: string, nowSeconds: number): Promise<SessionClaims | null> => {
+    const parts = token.split(".")
+    if (parts.length !== 3) {return null}
+    const header = parseJsonPart(parts[0])
+    if (header === null || header.alg !== "HS256") {return null}
+    let valid = false
+    try {
+        valid = await crypto.subtle.verify("HMAC", await hmacKey(secret, ["verify"]),
+            b64urlDecode(parts[2]), encoder.encode(`${parts[0]}.${parts[1]}`))
+    } catch (_error) {
+        return null
+    }
+    if (!valid) {return null}
+    const claims = parseJsonPart(parts[1])
+    if (claims === null || typeof claims.sub !== "string" || typeof claims.exp !== "number"
+        || typeof claims.iat !== "number" || claims.exp <= nowSeconds) {return null}
+    return {sub: claims.sub, iat: claims.iat, exp: claims.exp}
+}
+
+export type Jwk = { kid: string, kty: string, n: string, e: string, alg?: string, use?: string }
+
+export type VerifiedJwt = { header: Record<string, unknown>, payload: Record<string, unknown> }
+
+// A token signed by someone else (Google, RS256) against a set of public keys.
+export const verifyRs256 = async (token: string, keys: ReadonlyArray<Jwk>): Promise<VerifiedJwt | null> => {
+    const parts = token.split(".")
+    if (parts.length !== 3) {return null}
+    const header = parseJsonPart(parts[0])
+    const payload = parseJsonPart(parts[1])
+    if (header === null || payload === null || header.alg !== "RS256" || typeof header.kid !== "string") {return null}
+    const jwk = keys.find(key => key.kid === header.kid && key.kty === "RSA")
+    if (jwk === undefined) {return null}
+    try {
+        const key = await crypto.subtle.importKey("jwk", {kty: "RSA", n: jwk.n, e: jwk.e, alg: "RS256", ext: true},
+            {name: "RSASSA-PKCS1-v1_5", hash: "SHA-256"}, false, ["verify"])
+        const valid = await crypto.subtle.verify("RSASSA-PKCS1-v1_5", key,
+            b64urlDecode(parts[2]), encoder.encode(`${parts[0]}.${parts[1]}`))
+        return valid ? {header, payload} : null
+    } catch (_error) {
+        return null
+    }
+}
diff --git a/cloudflare-server/src/server.test.ts b/cloudflare-server/src/server.test.ts
