+    nonce: "n-123", email: "Me@Example.com", email_verified: true, sub: "1234567890", ...overrides
+})
+
+export const makeEnv = (signer: GoogleSigner, bucket: FakeBucket = new FakeBucket(), overrides: Partial<Env> = {}): Env => ({
