+import {afterEach, beforeEach, describe, expect, it} from "vitest"
+import {EchoSession} from "./EchoSession"
+
+const store = new Map<string, string>()
+
+describe("EchoSession", () => {
+    beforeEach(() => {
+        store.clear()
+        ;(globalThis as { localStorage?: unknown }).localStorage = {
+            getItem: (key: string) => store.get(key) ?? null,
+            setItem: (key: string, value: string) => void store.set(key, value),
+            removeItem: (key: string) => void store.delete(key)
+        }
+    })
+    afterEach(() => {delete (globalThis as { localStorage?: unknown }).localStorage})
+
+    const now = 1_700_000_000_000
+
+    it("remembers a login", () => {
+        EchoSession.write({token: "t", email: "me@example.com", expiresAt: now / 1000 + 3600})
+        expect(EchoSession.read(now)).toEqual({token: "t", email: "me@example.com", expiresAt: now / 1000 + 3600})
+    })
+
+    it("forgets a login that is over, or about to be", () => {
+        EchoSession.write({token: "t", email: "me@example.com", expiresAt: now / 1000 - 1})
+        expect(EchoSession.read(now)).toBeNull()
+        EchoSession.write({token: "t", email: "me@example.com", expiresAt: now / 1000 + 30})
+        expect(EchoSession.read(now)).toBeNull()
+    })
+
+    it("has nothing when nothing was stored, or what is stored is not a login", () => {
+        expect(EchoSession.read(now)).toBeNull()
+        store.set("opendaw-echo-session", "not json")
+        expect(EchoSession.read(now)).toBeNull()
+        store.set("opendaw-echo-session", JSON.stringify({token: 1}))
+        expect(EchoSession.read(now)).toBeNull()
+    })
+
+    it("clears", () => {
+        EchoSession.write({token: "t", email: "me@example.com", expiresAt: now / 1000 + 3600})
+        EchoSession.clear()
+        expect(EchoSession.read(now)).toBeNull()
+    })
+
+    it("does not break when the browser has no storage", () => {
+        delete (globalThis as { localStorage?: unknown }).localStorage
+        expect(() => EchoSession.write({token: "t", email: "e", expiresAt: 1})).not.toThrow()
+        expect(EchoSession.read(now)).toBeNull()
+        expect(() => EchoSession.clear()).not.toThrow()
+    })
+})
diff --git a/packages/studio/core/src/cloud/EchoSession.ts b/packages/studio/core/src/cloud/EchoSession.ts
new file mode 100644
index 0000000..eec4e0d
--- /dev/null
+++ b/packages/studio/core/src/cloud/EchoSession.ts
@@ -0,0 +1,36 @@
+// The login with the Echo storage server: a session token the server handed out after a Google sign-in. It is kept in
+// this browser, so that a reload or a relaunch of the app does not ask again.
+export namespace EchoSession {
+    const Key = "opendaw-echo-session"
+
+    export type Stored = {
+        readonly token: string
+        readonly email: string
+        // seconds since 1970, as the server states it
+        readonly expiresAt: number
+    }
+
+    // Stays a minute short of the end, so that a token is never used at the last moment.
+    const Margin = 60 * 1000
+
+    export const read = (nowMs: number = Date.now()): Stored | null => {
+        try {
+            const raw = localStorage.getItem(Key)
+            if (raw === null) {return null}
+            const stored: { token?: unknown, email?: unknown, expiresAt?: unknown } = JSON.parse(raw)
+            return typeof stored.token === "string" && typeof stored.email === "string"
+            && typeof stored.expiresAt === "number" && stored.expiresAt * 1000 - Margin > nowMs
+                ? {token: stored.token, email: stored.email, expiresAt: stored.expiresAt} : null
+        } catch (_error) {
+            return null
+        }
+    }
+
+    export const write = (session: Stored): void => {
+        try {localStorage.setItem(Key, JSON.stringify(session))} catch (_error) {/* not remembered */}
+    }
+
+    export const clear = (): void => {
+        try {localStorage.removeItem(Key)} catch (_error) {/* nothing to clear */}
+    }
+}
