@@ -0,0 +1,40 @@
+# EchoStudio storage server
+
+A small server on Cloudflare Workers that keeps the projects and audio of the app in an R2 bucket. The app signs in
+with Google, and only the emails on the allow list get in. Everybody has a private folder; nobody sees another folder.
+
+## What it does
+
+| Route | What |
+|---|---|
+| `POST /auth/google` | trades a Google ID token for a session (30 days). Only allowed emails. |
+| `GET /auth/me` | who is signed in |
+| `GET/PUT/HEAD/DELETE /files/<path>` | a file (a folder for `HEAD` and `DELETE`: everything below it) |
+| `GET /list?path=<folder>` | names inside a folder |
+| `POST /mpu/create`, `PUT /mpu/part`, `POST /mpu/complete`, `POST /mpu/abort` | files above 95 MB go up in parts |
+
+The shared catalog files (`index.json`, `tombstones.json`, `structure.json`) are only overwritten by a device that
+has read their latest version (`X-Echo-If-Match`), so two devices cannot wipe each other's changes.
+
+## One-time setup
+
+1. **Cloudflare**: an R2 bucket named `echostudio-audio` (R2 object storage, Create bucket), and a workers.dev name for
+   the account (Workers & Pages).
+2. **API token** (My Profile, API Tokens): the token the app deploy uses also needs the rights
+   *Workers Scripts: Edit* and *Workers R2 Storage: Edit* (keep *Cloudflare Pages: Edit*).
+3. **GitHub** (the repository, Settings, Secrets and variables, Actions, Variables):
+   - `ALLOWED_EMAILS`: your Google email(s), separated by commas
+   - `ECHO_SERVER_URL`: `https://echostudio-server.<your workers.dev name>.workers.dev`
+   - `GOOGLE_DRIVE_CLIENT_ID` is already there.
+4. Run **Deploy EchoStudio server to Cloudflare** (Actions), then deploy the app again.
+5. In the app, tap **Sync**, sign in with Google. From then on projects sync by themselves.
+
+The Google project must list your email as a test user (OAuth consent screen, Test users) while it is in testing mode.
+Nothing but the email is read from the Google account.
+
+## Checks
+
+```
+npx vitest run                      # server logic with a fake bucket, and the app's handler against the real server code
+ECHO_INTEGRATION=1 WRANGLER_BIN=$(which wrangler) npx vitest run integration   # on Cloudflare's local runtime
+```
diff --git a/cloudflare-server/integration/contract.test.ts b/cloudflare-server/integration/contract.test.ts
new file mode 100644
index 0000000..bd1a432
--- /dev/null
+++ b/cloudflare-server/integration/contract.test.ts
@@ -0,0 +1,107 @@
+// The app's storage handler against the real server code, in one process (no network, a fake bucket).
+// Needs the monorepo checked out (it imports the handler from packages/studio/core).
+import {beforeEach, describe, expect, it} from "vitest"
+import worker from "../src/index"
+import {issueSession} from "../src/auth"
+import {Env} from "../src/types"
+import {createGoogleSigner, FakeBucket, makeEnv} from "../src/testkit"
+import {EchoCloudHandler, EchoPreconditionFailed, EchoSessionExpired} from "../../packages/studio/core/src/cloud/EchoCloudHandler"
+
+const bytes = (...values: Array<number>) => new Uint8Array(values).buffer as ArrayBuffer
+const text = (value: string) => new TextEncoder().encode(value).buffer as ArrayBuffer
+const read = (buffer: ArrayBuffer) => new TextDecoder().decode(buffer)
+
+describe("the app's handler and the server together", () => {
+    let env: Env
+    let bucket: FakeBucket
+    let token: string
+    let expired = 0
+    const handlerFor = (sessionToken: string, limits?: { singleLimit?: number, partSize?: number }) =>
+        new EchoCloudHandler("https://server.example", sessionToken,
+            (input, init) => worker.fetch(new Request(input as string, {
+                ...init,
+                // a real request carries its length
+                headers: {...(init?.headers as Record<string, string>), ...(init?.body instanceof ArrayBuffer
+                    ? {"Content-Length": String(init.body.byteLength)} : typeof init?.body === "string"
+                        ? {"Content-Length": String(new TextEncoder().encode(init.body).length)} : {})}
+            }), env), () => {expired++}, limits)
+
+    beforeEach(async () => {
+        const signer = await createGoogleSigner()
+        bucket = new FakeBucket()
+        env = makeEnv(signer, bucket)
+        token = (await issueSession(env, "me@example.com", Math.floor(Date.now() / 1000))).token
+        expired = 0
+    })
+
+    it("is alive with a good login and not with a bad one", async () => {
+        await expect(handlerFor(token).alive()).resolves.toBeUndefined()
+        await expect(handlerFor("bad").alive()).rejects.toBeInstanceOf(EchoSessionExpired)
+        expect(expired).toBe(1)
+    })
+
+    it("uploads, downloads, lists, checks and deletes like a cloud folder", async () => {
+        const handler = handlerFor(token)
+        await handler.upload("projects/p1/project.od", bytes(1, 2, 3))
+        await handler.upload("projects/p1/meta.json", text("{\"name\":\"Song\"}"))
+        await handler.upload("projects/p2/meta.json", text("{}"))
+        expect(Array.from(new Uint8Array(await handler.download("projects/p1/project.od")))).toEqual([1, 2, 3])
+        expect((await handler.list("projects/p1")).sort()).toEqual(["meta.json", "project.od"])
+        expect((await handler.list("projects")).sort()).toEqual(["p1", "p2"])
+        expect(await handler.exists("projects/p1")).toBe(true)
+        expect(await handler.exists("projects/p1/meta.json")).toBe(true)
+        expect(await handler.exists("projects/p3")).toBe(false)
+        await handler.delete("projects/p1")
+        expect(await handler.exists("projects/p1")).toBe(false)
+        expect(await handler.exists("projects/p2")).toBe(true)
+        await expect(handler.download("projects/p1/project.od")).rejects.toThrow("projects/p1/project.od")
+    })
+
+    it("sends names with spaces and special characters through unharmed", async () => {
+        const handler = handlerFor(token)
+        await handler.upload("presence/a b/c+d#e.json", text("note"))
+        expect(read(await handler.download("presence/a b/c+d#e.json"))).toBe("note")
+        expect(await handler.list("presence/a b")).toEqual(["c+d#e.json"])
+    })
+
+    it("sends a big file in parts and gets the same bytes back", async () => {
+        const handler = handlerFor(token, {singleLimit: 100, partSize: 64})
+        const big = new Uint8Array(300).map((_, index) => index % 251)
+        await handler.upload("samples/big.wav", big.buffer as ArrayBuffer)
+        expect(Array.from(new Uint8Array(await handler.download("samples/big.wav")))).toEqual(Array.from(big))
+    })
+
+    it("stops two devices from overwriting each other's catalog", async () => {
+        const first = handlerFor(token)
+        const second = handlerFor(token)
+        await first.upload("projects/index.json", text("{}"))
+        await first.download("projects/index.json")
+        await second.download("projects/index.json")
+        await second.upload("projects/index.json", text("{\"a\":1}"))
+        // the first device still holds the old version: its write is refused instead of wiping the second one's work
+        await expect(first.upload("projects/index.json", text("{\"b\":2}"))).rejects.toBeInstanceOf(EchoPreconditionFailed)
+        expect(read(await second.download("projects/index.json"))).toBe("{\"a\":1}")
+        // after reading the latest version again, the first device may write
+        await first.download("projects/index.json")
+        await first.upload("projects/index.json", text("{\"a\":1,\"b\":2}"))
+        expect(read(await second.download("projects/index.json"))).toBe("{\"a\":1,\"b\":2}")
+    })
+
+    it("lets two devices write their own project files without checks", async () => {
+        const first = handlerFor(token)
+        const second = handlerFor(token)
+        await first.upload("projects/p1/project.od", bytes(1))
+        await second.download("projects/p1/project.od")
+        await first.upload("projects/p1/project.od", bytes(2))
+        await second.upload("projects/p1/project.od", bytes(3))
+        expect(Array.from(new Uint8Array(await first.download("projects/p1/project.od")))).toEqual([3])
+    })
+
+    it("keeps two people's files apart", async () => {
+        const mine = handlerFor(token)
+        const other = handlerFor((await issueSession(env, "other@example.com", Math.floor(Date.now() / 1000))).token)
+        await mine.upload("projects/index.json", text("mine"))
+        expect(await other.exists("projects/index.json")).toBe(false)
+        expect(await other.list("projects")).toEqual([])
+    })
+})
diff --git a/cloudflare-server/integration/local.test.ts b/cloudflare-server/integration/local.test.ts
new file mode 100644
index 0000000..dfff13d
--- /dev/null
+++ b/cloudflare-server/integration/local.test.ts
@@ -0,0 +1,122 @@
+// Runs the real server code on Cloudflare's local Workers runtime (wrangler dev), with a local R2 bucket.
+// Only when ECHO_INTEGRATION=1 and WRANGLER_BIN points at a wrangler install, so the normal test run stays quick:
+//   ECHO_INTEGRATION=1 WRANGLER_BIN=/path/to/wrangler npx vitest run integration
+import {afterAll, beforeAll, describe, expect, it} from "vitest"
+import {ChildProcess, spawn} from "node:child_process"
+import {mkdtempSync, rmSync, writeFileSync} from "node:fs"
+import {tmpdir} from "node:os"
+import {join, resolve} from "node:path"
+import {createGoogleSigner, ClientId, goodClaims} from "../src/testkit"
+
+const enabled = process.env.ECHO_INTEGRATION === "1" && process.env.WRANGLER_BIN !== undefined
+const Port = 8799
+const Base = `http://127.0.0.1:${Port}`
+const Origin = "https://echo-says-echo.pages.dev"
+
+describe.skipIf(!enabled)("on the local Workers runtime", () => {
+    const root = resolve(__dirname, "..")
+    const devVars = join(root, ".dev.vars")
+    const state = mkdtempSync(join(tmpdir(), "echo-state-"))
+    let server: ChildProcess
+    let token = ""
+    const logs: Array<string> = []
+
+    const api = (path: string, init: RequestInit = {}) => fetch(`${Base}${path}`, {
+        ...init, headers: {Authorization: `Bearer ${token}`, ...(init.headers as Record<string, string> ?? {})}
+    })
+
+    beforeAll(async () => {
+        const signer = await createGoogleSigner()
+        writeFileSync(devVars, [
+            `GOOGLE_CLIENT_ID=${ClientId}`, "ALLOWED_EMAILS=me@example.com", `ALLOWED_ORIGINS=${Origin}`,
+            "SESSION_SECRET=integration-secret-0123456789abcdef", `JWKS_OVERRIDE=${signer.jwks}`
+        ].join("\n"))
+        server = spawn(process.env.WRANGLER_BIN as string,
+            ["dev", "--local", "--ip", "127.0.0.1", "--port", String(Port), "--persist-to", state],
+            {cwd: root, env: {...process.env, CI: "true", WRANGLER_SEND_METRICS: "false"}})
+        server.stdout?.on("data", chunk => logs.push(String(chunk)))
+        server.stderr?.on("data", chunk => logs.push(String(chunk)))
+        const deadline = Date.now() + 120_000
+        while (Date.now() < deadline) {
+            const ready = await fetch(`${Base}/`).then(response => response.ok, () => false)
+            if (ready) {break}
+            await new Promise(resolve => setTimeout(resolve, 500))
+        }
+        const idToken = await signer.sign(goodClaims(Math.floor(Date.now() / 1000)))
+        const login = await fetch(`${Base}/auth/google`, {method: "POST", body: JSON.stringify({idToken, nonce: "n-123"})})
+        expect(login.status, logs.join("")).toBe(200)
+        token = ((await login.json()) as { token: string }).token
+    }, 150_000)
+
+    afterAll(() => {
+        server?.kill("SIGTERM")
+        rmSync(devVars, {force: true})
+        rmSync(state, {recursive: true, force: true})
+    })
+
+    it("stores, reads, lists, checks and deletes files in R2", async () => {
+        const put = await api("/files/projects/p1/project.od", {method: "PUT", body: new Uint8Array([1, 2, 3, 4, 5])})
+        expect(put.status).toBe(200)
+        const read = await api("/files/projects/p1/project.od")
+        expect(Array.from(new Uint8Array(await read.arrayBuffer()))).toEqual([1, 2, 3, 4, 5])
+        await api("/files/projects/p1/meta.json", {method: "PUT", body: "{}"})
+        const listed = await (await api("/list?path=projects/p1")).json() as { names: Array<string> }
+        expect(listed.names.sort()).toEqual(["meta.json", "project.od"])
+        const folders = await (await api("/list?path=projects")).json() as { names: Array<string> }
+        expect(folders.names).toEqual(["p1"])
+        expect((await api("/files/projects/p1", {method: "HEAD"})).status).toBe(200)
+        expect((await api("/files/projects/p9", {method: "HEAD"})).status).toBe(404)
+        expect((await api("/files/projects/p1", {method: "DELETE"})).status).toBe(200)
+        expect((await api("/files/projects/p1/project.od")).status).toBe(404)
+    }, 30_000)
+
+    it("refuses to overwrite a file somebody else changed (real R2 etags)", async () => {
+        const first = await (await api("/files/projects/index.json", {method: "PUT", body: "v1"})).json() as { etag: string }
+        const read = await api("/files/projects/index.json")
+        expect(read.headers.get("ETag")).toBe(`"${first.etag}"`)
+        const second = await api("/files/projects/index.json", {method: "PUT", body: "v2", headers: {"X-Echo-If-Match": first.etag}})
+        expect(second.status).toBe(200)
+        const stale = await api("/files/projects/index.json", {method: "PUT", body: "v3", headers: {"X-Echo-If-Match": first.etag}})
+        expect(stale.status).toBe(412)
+        expect(await (await api("/files/projects/index.json")).text()).toBe("v2")
+    }, 30_000)
+
+    it("streams a 20 MB file in and out unchanged", async () => {
+        const data = new Uint8Array(20 * 1024 * 1024)
+        for (let i = 0; i < data.length; i += 4099) {data[i] = (i / 4099) % 251}
+        expect((await api("/files/samples/one.wav", {method: "PUT", body: data})).status).toBe(200)
+        const back = new Uint8Array(await (await api("/files/samples/one.wav")).arrayBuffer())
+        expect(back.length).toBe(data.length)
+        expect(Buffer.compare(Buffer.from(back), Buffer.from(data))).toBe(0)
+    }, 60_000)
+
+    it("assembles a file from parts of equal size", async () => {
+        const partSize = 5 * 1024 * 1024
+        const sizes = [partSize, partSize, 1234]
+        const whole = new Uint8Array(sizes.reduce((sum, size) => sum + size, 0))
+        for (let i = 0; i < whole.length; i += 997) {whole[i] = (i / 997) % 253}
+        const {uploadId} = await (await api("/mpu/create?path=samples/parts.wav", {method: "POST"})).json() as { uploadId: string }
+        const parts = []
+        let offset = 0
+        for (const [index, size] of sizes.entries()) {
+            const response = await api(`/mpu/part?path=samples/parts.wav&uploadId=${uploadId}&part=${index + 1}`,
+                {method: "PUT", body: whole.slice(offset, offset + size)})
+            expect(response.status, logs.join("")).toBe(200)
+            parts.push(await response.json())
+            offset += size
+        }
+        const done = await api(`/mpu/complete?path=samples/parts.wav&uploadId=${uploadId}`,
+            {method: "POST", body: JSON.stringify({parts})})
+        expect(done.status, logs.join("")).toBe(200)
+        const back = new Uint8Array(await (await api("/files/samples/parts.wav")).arrayBuffer())
+        expect(Buffer.compare(Buffer.from(back), Buffer.from(whole))).toBe(0)
+    }, 60_000)
+
+    it("answers the browser's preflight and exposes the etag", async () => {
+        const preflight = await fetch(`${Base}/files/x`, {method: "OPTIONS", headers: {Origin}})
+        expect(preflight.status).toBe(204)
+        expect(preflight.headers.get("access-control-allow-origin")).toBe(Origin)
+        const read = await api("/auth/me", {headers: {Origin}})
+        expect(read.headers.get("access-control-expose-headers")).toContain("ETag")
+    })
+})
